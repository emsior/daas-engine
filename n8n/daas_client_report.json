{
  "name": "DaaS Engine — client CSV → report (webhook)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "daas-report",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2d3e4f5-0001-4000-8000-000000000001",
      "name": "Webhook (POST /webhook/daas-report)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "daas-report"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:8000/upload",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "file" },
            { "name": "client_name", "value": "={{ $json.body.client_name || $json.query.client_name || 'Klient' }}" }
          ]
        },
        "options": { "timeout": 60000 }
      },
      "id": "b2d3e4f5-0002-4000-8000-000000000002",
      "name": "POST /upload (plik klienta)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c-ready",
              "leftValue": "={{ $json.ready }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2d3e4f5-0003-4000-8000-000000000003",
      "name": "Plik OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:8000/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.run_payload) }}",
        "options": { "timeout": 120000 }
      },
      "id": "b2d3e4f5-0004-4000-8000-000000000004",
      "name": "POST /run (source_path)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 200]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst m = r.metrics || {};\nconst base = $env.DAAS_PUBLIC_URL || 'http://localhost:8000';\nreturn [{ json: {\n  ok: r.run_status === 'SUCCESS',\n  run_id: r.run_id,\n  client_name: r.client_name,\n  data_status: r.data_status,\n  records: r.records_processed,\n  report_html_url: `${base}/reports/run/${r.run_id}`,\n  report_json_url: `${base}/reports/run/${r.run_id}?fmt=json`,\n  headline: `Przychód ${m.revenue_total} · zysk ${m.profit_total} · marża ${m.margin_pct}% · stratne ${m.loss_orders_count}`,\n  error: r.error || null,\n}}];"
      },
      "id": "b2d3e4f5-0005-4000-8000-000000000005",
      "name": "Zbuduj odpowiedź",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "b2d3e4f5-0006-4000-8000-000000000006",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1300, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, reason: 'file not usable', mapping: $json.mapping, unmapped: $json.unmapped_columns, warnings: $json.warnings }) }}",
        "options": { "responseCode": 422 }
      },
      "id": "b2d3e4f5-0007-4000-8000-000000000007",
      "name": "Respond 422",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [780, 440]
    }
  ],
  "connections": {
    "Webhook (POST /webhook/daas-report)": { "main": [[{ "node": "POST /upload (plik klienta)", "type": "main", "index": 0 }]] },
    "POST /upload (plik klienta)": { "main": [[{ "node": "Plik OK?", "type": "main", "index": 0 }]] },
    "Plik OK?": {
      "main": [
        [{ "node": "POST /run (source_path)", "type": "main", "index": 0 }],
        [{ "node": "Respond 422", "type": "main", "index": 0 }]
      ]
    },
    "POST /run (source_path)": { "main": [[{ "node": "Zbuduj odpowiedź", "type": "main", "index": 0 }]] },
    "Zbuduj odpowiedź": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Europe/Warsaw" },
  "active": false,
  "pinData": {},
  "versionId": "1",
  "tags": [{ "name": "daas" }]
}

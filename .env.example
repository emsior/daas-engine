# ===== DAAS ENGINE — zmienne środowiskowe =====
# Skopiuj do .env i uzupełnij. Puste = pipeline przełącza się na fixtures (MOCK_DATA).

# --- Źródła danych ---
FACEIT_API_KEY=
FACEIT_PLAYER_NICKNAME=
LIQUIPEDIA_USER_AGENT=
APIFY_TOKEN=

# --- Powiadomienia ---
DISCORD_WEBHOOK_URL=

# --- Streszczenie LLM w raporcie (domyślnie WYŁĄCZONE) ---
# Samo ANTHROPIC_API_KEY niczego nie włącza: dane do zewnętrznego dostawcy wychodzą tylko przy
# DAAS_LLM_NARRATIVE=true. Do dostawcy trafiają wyłącznie policzone metryki (bez order_id, nazw
# produktów, nazwy klienta, hosta i skrótów paczki). Raport oznacza takie streszczenie jako wygenerowane przez model.
DAAS_LLM_NARRATIVE=false
ANTHROPIC_API_KEY=
NARRATIVE_MODEL=claude-sonnet-4-5

# --- Dane klienta (opcjonalne; zamiast tego użyj POST /upload) ---
ECOMMERCE_CSV_PATH=
APIFY_DATASET_ID=

# --- Aplikacja ---
# APP_ENV=dev włącza /docs, /redoc, /openapi.json i auto-reload; każda inna wartość (domyślnie prod) je wyłącza.
APP_ENV=prod
# Domyślnie loopback. Inny adres (np. 0.0.0.0) wymaga DAAS_API_KEY, inaczej start jest odmawiany.
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
# Liczniki limitów są w pamięci procesu: dokładnie JEDEN worker (WEB_CONCURRENCY/UVICORN_WORKERS > 1 blokuje start).

# --- Uwierzytelnianie ---
# Klucz w nagłówku X-API-Key dla wszystkich tras poza /health i /ready. Minimum 16 znaków.
# Brak klucza = fail-closed (401 na trasach chronionych). Wygeneruj: openssl rand -hex 32
DAAS_API_KEY=

# --- Limity (0 = wyłączony) ---
DAAS_RATE_LIMIT_RUN_PER_MIN=30
DAAS_RATE_LIMIT_UPLOAD_PER_MIN=30
DAAS_RATE_LIMIT_IP_PER_MIN=300
DAAS_RATE_LIMIT_AUTH_FAIL_PER_MIN=10
# Łączna kwota bajtów w uploads/ (domyślnie 1 GiB); po przekroczeniu POST /upload odpowiada 413.
DAAS_UPLOAD_QUOTA_BYTES=1073741824

# --- Policy layer ---
# true (domyślnie) = policy egzekwuje granicę katalogu roboczego i zapisuje decyzje do audytu;
#        przy odmowie żądanie kończy się błędem (fail-closed).
# false = wyłącza kontrolę (tylko świadoma decyzja operatora).
# Model wdrożenia: JEDEN KLIENT = JEDNA INSTANCJA = JEDEN RUNTIME ROOT.
DAAS_POLICY_ENFORCE=true

# --- Storage ---
DUCKDB_PATH=runtime/daas.duckdb
REPORTS_DIR=runtime/reports
FIXTURES_DIR=data/fixtures

# --- n8n ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_ENCRYPTION_KEY=change_me_32_chars_minimum_please
GENERIC_TIMEZONE=Europe/Warsaw

# ===== TRYB CLOUD (DAAS_MODE=cloud) =====
# Wdrożenie cloud ma własny szablon: deploy/gen-env.sh tworzy deploy/.env z losowymi sekretami.
# Poniżej pełna lista zmiennych trybu cloud z wartościami domyślnymi (zakomentowane = obowiązuje domyślna).
# Opis każdej zmiennej: docs/DEPLOY.md.

# selfhost (domyślnie) = jedna organizacja `default` i klucz DAAS_API_KEY; cloud = wiele organizacji, kokpit, klucze per organizacja.
# DAAS_MODE=selfhost

# --- Control plane (baza kont, kluczy, zadań, audytu) ---
# SQLite domyślnie; Postgres: postgresql+asyncpg://uzytkownik:haslo@host/baza (wymaga pakietu asyncpg)
# DAAS_CONTROL_DB_URL=sqlite+aiosqlite:///runtime/control.db
# Przy starcie wykonaj `alembic upgrade head` (idempotentne). false = migracje robi operator: python -m app.cli migrate
# DAAS_AUTO_MIGRATE=true

# --- Sesje i kokpit ---
# WYMAGANE w trybie cloud (min. 32 znaki): podpis cookie sesji i sekretów webhooków. Wygeneruj: openssl rand -hex 32
# Zmiana wylogowuje wszystkich i unieważnia podpisy webhooków. Nigdy do repozytorium.
# DAAS_SECRET_KEY=
# Jedyny origin kokpitu dopuszczony przez CORS z cookie, np. https://raporty.example.com. Brak = CORS wyłączony.
# DAAS_COCKPIT_ORIGIN=
# Atrybut Secure cookie sesji. false tylko do lokalnych prób po http.
# DAAS_COOKIE_SECURE=true
# Ważność sesji w godzinach (336 = 14 dni) i linku logowania w minutach (1-120).
# DAAS_SESSION_TTL_HOURS=336
# DAAS_MAGIC_LINK_TTL_MINUTES=15
# Origin dla CORS bez cookie (lista JSON), np. CORS_ORIGINS='["https://example.com"]'
# CORS_ORIGINS=[]

# --- Poczta (link logowania, zaproszenia) ---
# console = link tylko w dzienniku i w runtime/outbox/ (próby, testy e2e); smtp = produkcja.
# DAAS_EMAIL_BACKEND=console
# DAAS_EMAIL_FROM=DaaS Engine <no-reply@localhost>
# DAAS_SMTP_HOST=
# DAAS_SMTP_PORT=587
# DAAS_SMTP_USER=
# DAAS_SMTP_PASSWORD=
# DAAS_SMTP_STARTTLS=true

# --- Limity cloud (0 = wyłączony tam, gdzie to dozwolone) ---
# Prośby o link logowania na minutę: per adres e-mail i per adres IP.
# DAAS_RATE_LIMIT_MAGIC_EMAIL_PER_MIN=3
# DAAS_RATE_LIMIT_MAGIC_IP_PER_MIN=10
# Równoległe runy w całym procesie (1-64); w obrębie organizacji zawsze jeden.
# DAAS_MAX_CONCURRENT_RUNS=2
# Ile organizacji ma jednocześnie otwartą bazę DuckDB (LRU, 1-1024).
# DAAS_MAX_ACTIVE_TENANTS=16
# Domyślna retencja uploadów nowej organizacji, w dniach.
# DAAS_RETENTION_DAYS=90

# --- Webhooki, SSE, metryki ---
# Pauzy (sekundy) między ponowieniami dostawy webhooka, po jednej próbie początkowej.
# DAAS_WEBHOOK_BACKOFF_SEC=1,5,25
# Odstęp komentarza `: heartbeat` w strumieniu zdarzeń (SSE), w sekundach.
# DAAS_SSE_HEARTBEAT_SEC=15
# Token dla GET /metrics (Authorization: Bearer ...). Bez tokenu trasa odpowiada 404. openssl rand -hex 24
# DAAS_METRICS_TOKEN=

# --- Zmienne wdrożenia deploy/compose.yml (czyta je docker compose, nie aplikacja) ---
# DAAS_VERSION=2.0.0
# DAAS_DOMAIN=raporty.example.com
# NEXT_PUBLIC_API_ORIGIN=

# --- Pozostałe (opcjonalne) ---
# Nazwa w OpenAPI i /health, wersja awaryjna (jawna wersja pochodzi z metadanych pakietu), limit czasu zapytań do źródeł (s).
# APP_NAME=DaaS Engine
# APP_VERSION=2.0.0
# SOURCE_TIMEOUT_SEC=10

# ===== DAAS ENGINE — zmienne środowiskowe =====
# Skopiuj do .env i uzupełnij. Puste = pipeline przełącza się na fixtures (MOCK_DATA).

# --- Źródła danych ---
FACEIT_API_KEY=
FACEIT_PLAYER_NICKNAME=
LIQUIPEDIA_USER_AGENT=
APIFY_TOKEN=

# --- Powiadomienia ---
DISCORD_WEBHOOK_URL=

# --- Streszczenie LLM w raporcie (domyślnie WYŁĄCZONE) ---
# Samo ANTHROPIC_API_KEY niczego nie włącza: dane do zewnętrznego dostawcy wychodzą tylko przy
# DAAS_LLM_NARRATIVE=true. Do dostawcy trafiają wyłącznie policzone metryki (bez order_id, nazw
# produktów, nazwy klienta, hosta i skrótów paczki). Raport oznacza takie streszczenie jako wygenerowane przez model.
DAAS_LLM_NARRATIVE=false
ANTHROPIC_API_KEY=
NARRATIVE_MODEL=claude-sonnet-4-5

# --- Dane klienta (opcjonalne; zamiast tego użyj POST /upload) ---
ECOMMERCE_CSV_PATH=
APIFY_DATASET_ID=

# --- Aplikacja ---
# APP_ENV=dev włącza /docs, /redoc, /openapi.json i auto-reload; każda inna wartość (domyślnie prod) je wyłącza.
APP_ENV=prod
# Domyślnie loopback. Inny adres (np. 0.0.0.0) wymaga DAAS_API_KEY, inaczej start jest odmawiany.
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
# Liczniki limitów są w pamięci procesu: dokładnie JEDEN worker (WEB_CONCURRENCY/UVICORN_WORKERS > 1 blokuje start).

# --- Uwierzytelnianie ---
# Klucz w nagłówku X-API-Key dla wszystkich tras poza /health i /ready. Minimum 16 znaków.
# Brak klucza = fail-closed (401 na trasach chronionych). Wygeneruj: openssl rand -hex 32
DAAS_API_KEY=

# --- Limity (0 = wyłączony) ---
DAAS_RATE_LIMIT_RUN_PER_MIN=30
DAAS_RATE_LIMIT_UPLOAD_PER_MIN=30
DAAS_RATE_LIMIT_IP_PER_MIN=300
DAAS_RATE_LIMIT_AUTH_FAIL_PER_MIN=10
# Łączna kwota bajtów w uploads/ (domyślnie 1 GiB); po przekroczeniu POST /upload odpowiada 413.
DAAS_UPLOAD_QUOTA_BYTES=1073741824

# --- Policy layer ---
# true (domyślnie) = policy egzekwuje granicę katalogu roboczego i zapisuje decyzje do audytu;
#        przy odmowie żądanie kończy się błędem (fail-closed).
# false = wyłącza kontrolę (tylko świadoma decyzja operatora).
# Model wdrożenia: JEDEN KLIENT = JEDNA INSTANCJA = JEDEN RUNTIME ROOT.
DAAS_POLICY_ENFORCE=true

# --- Storage ---
DUCKDB_PATH=runtime/daas.duckdb
REPORTS_DIR=runtime/reports
FIXTURES_DIR=data/fixtures

# --- n8n ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_ENCRYPTION_KEY=change_me_32_chars_minimum_please
GENERIC_TIMEZONE=Europe/Warsaw
